{
  "name": "perch-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5418 --strictPort --configLoader native",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --configLoader native",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js src tests scripts",
    "test": "node --experimental-strip-types --test tests/model.test.ts tests/furniture.test.ts",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "vite": "7.3.6",
    "typescript": "5.9.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
